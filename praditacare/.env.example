# Salin file ini menjadi .env (cp .env.example .env). File .env TIDAK boleh di-commit (sudah ada di .gitignore).
DATABASE_URL="mysql://root:root@localhost:3306/praditacare"
# Wajib diganti untuk deploy: jalankan `npm run gen:secret` lalu tempel hasilnya (minimal 32 karakter).
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
JWT_EXPIRES_IN="8h"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# development = lokal (npm run dev). production = deploy (npm start): server menolak menyala bila JWT_SECRET masih contoh.
NODE_ENV="development"
# Isi 1 bila API berada di belakang satu reverse proxy (Nginx, dsb.) agar rate limit login memakai IP asli.
TRUST_PROXY=0
# Web hasil build disajikan oleh API: otomatis true bila NODE_ENV=production.
# SERVE_WEB=true
