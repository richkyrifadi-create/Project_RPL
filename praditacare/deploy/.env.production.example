# Konfigurasi deploy produksi (Docker). Salin: cp deploy/.env.production.example deploy/.env
# File deploy/.env TIDAK boleh di-commit.

# Alamat publik server: IP VPS / IP Raspberry Pi / domain. Dipakai untuk CORS dan sertifikat.
PUBLIC_HOST=203.0.113.10

# Sub-path aplikasi. Reviewer membuka https://<PUBLIC_HOST>/praditacare/
BASE_PATH=/praditacare/

# Wajib diganti. Buat dengan: openssl rand -hex 48
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-48

# Password database (bebas, panjang, acak). Buat dengan: openssl rand -hex 16
DB_PASSWORD=ganti-password-database
DB_ROOT_PASSWORD=ganti-password-root-database

# true = isi data demo (9 akun, password Pradita123!) agar reviewer bisa login.
# Untuk penggunaan sungguhan (bukan demo) set false.
SEED_DEMO_DATA=true

# Port yang dibuka di server.
HTTP_PORT=80
HTTPS_PORT=443
