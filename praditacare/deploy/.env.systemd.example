# .env produksi untuk instalasi tanpa Docker (systemd). Salin ke praditacare/.env lalu isi.
DATABASE_URL="mysql://praditacare:GANTI_PASSWORD_DB@localhost:3306/praditacare"
# Buat dengan: openssl rand -hex 48
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_48"
JWT_EXPIRES_IN="8h"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
PORT=4000
# Alamat publik, mis. https://203.0.113.10
CORS_ORIGIN="https://GANTI_IP_ATAU_DOMAIN"
NODE_ENV="production"
# API berada di belakang satu reverse proxy (Nginx).
TRUST_PROXY=1
